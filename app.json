{
  "expo": {
    "name": "Beni_Mellal_Tourism_App",
    "slug": "Beni_Mellal_Tourism_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/camel-49482991.png",
    "scheme": "benimellaltourismapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/camel-49482991.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zakarai.Beni-Mellal-Tourism-App",
      "splash": {
        "image": "./assets/images/camel-49482991.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/images/camel-49482991.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zakarai.Beni_Mellal_Tourism_App"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/images/camel-49482991.png",
          "dark": {
            "image": "./assets/images/camel-49482991.png",

            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
